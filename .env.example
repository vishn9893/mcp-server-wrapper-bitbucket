BITBUCKET_URL=https://bitbucket.example.com
# Prefer a personal access token for Bitbucket Server/Data Center.
BITBUCKET_TOKEN=
# Alternatively use HTTP basic authentication:
BITBUCKET_USERNAME=
BITBUCKET_PASSWORD=
BITBUCKET_VERIFY_TLS=true
BITBUCKET_TIMEOUT=30
BITBUCKET_MAX_RETRIES=3
BITBUCKET_TRANSPORT=stdio
